const int buttonPin = 2;
void setup() {
  // put your setup code here, to run once:
  Serial.begin(9600); 
  pinMode(buttonPin, INPUT_PULLUP);

}

void loop() {
  // // put your main code here, to run rçepeatedly:
  //  // Read the state of the button
  int buttonState = digitalRead(buttonPin);
  
  // If the button is pressed (pulled down to GND)
  if (buttonState == LOW) {
    Serial.println("LOW");  // Turn off the A0 output
    delay(1000);
  } else {
    Serial.println("HIGH");
    delay(1000);
  }
}

